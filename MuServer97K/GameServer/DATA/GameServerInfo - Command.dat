CommandWareNumber_AL1 = 1 // Quantidade maxima de baus extras permitidos (Comando /ware) (VIP 1)
CommandWareNumber_AL2 = 1 // Quantidade maxima de baus extras permitidos (Comando /ware) (VIP 2)
CommandWareNumber_AL3 = 1 // Quantidade maxima de baus extras permitidos (Comando /ware) (VIP 3)

