[GameServerInfo]
;==================================================
; Post Command Settings
;==================================================
CommandPostGlobal = 0 // 0 = Post apenas na propria sala, 1 = Post global para todas as salas/sub-servidores
CommandPostType = 0 // Tipo de exibicao do Post (0 = Mensagem amarela, 1 = Chat normal, etc.)
CommandPostMessage = 323 // ID da mensagem no Message.txt correspondente ao formato do Post

;==================================================
; Clear PK Command Settings
;==================================================
CommandPKClearType = 0 // Tipo de cobranca do PK Clear (0 = Fixo, 1 = Multiplicado por quantidade de mortes/PKs)
CommandPKClearMoney_AL0 = 0 // Custo em Zen para limpar PK (Free)
CommandPKClearMoney_AL1 = 0 // Custo em Zen para limpar PK (VIP 1)
CommandPKClearMoney_AL2 = 0 // Custo em Zen para limpar PK (VIP 2)
CommandPKClearMoney_AL3 = 0 // Custo em Zen para limpar PK (VIP 3)

;==================================================
; Add Point Command Settings
;==================================================
CommandAddPointAutoEnable_AL0 = 1 // Habilitar comando de adicionar pontos automaticos (/addstr, /addagi, etc.) (0 = Nao, 1 = Sim) (Free)
CommandAddPointAutoEnable_AL1 = 1 // Habilitar comando de adicionar pontos automaticos (/addstr, /addagi, etc.) (0 = Nao, 1 = Sim) (VIP 1)
CommandAddPointAutoEnable_AL2 = 1 // Habilitar comando de adicionar pontos automaticos (/addstr, /addagi, etc.) (0 = Nao, 1 = Sim) (VIP 2)
CommandAddPointAutoEnable_AL3 = 1 // Habilitar comando de adicionar pontos automaticos (/addstr, /addagi, etc.) (0 = Nao, 1 = Sim) (VIP 3)

;==================================================
; Change Command Settings
;==================================================
CommandChangeLimit_AL0 = 1 // Habilitar o comando de evolucao de classe /change no chat (0 = Nao, 1 = Sim) (Free)
CommandChangeLimit_AL1 = 1 // Habilitar o comando de evolucao de classe /change no chat (0 = Nao, 1 = Sim) (VIP 1)
CommandChangeLimit_AL2 = 1 // Habilitar o comando de evolucao de classe /change no chat (0 = Nao, 1 = Sim) (VIP 2)
CommandChangeLimit_AL3 = 1 // Habilitar o comando de evolucao de classe /change no chat (0 = Nao, 1 = Sim) (VIP 3)

;==================================================
; Ware Command Settings
;==================================================
